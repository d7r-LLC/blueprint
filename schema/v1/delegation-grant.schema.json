{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint-spec.dev/schema/v1/delegation-grant.schema.json",
  "title": "DEFER Delegation Grant",
  "description": "A signed instrument conferring an authority envelope. Append only. Every chain MUST terminate in a human signature (DEFER 8.2).",
  "type": "object",
  "required": ["contractVersion", "grantId", "grantedBy", "grantedTo", "envelope", "validFrom", "validUntil", "redelegation", "revocationAuthority", "signature"],
  "additionalProperties": false,
  "properties": {
    "contractVersion": { "const": "defer-grant/v1" },
    "grantId": { "type": "string", "pattern": "^grant:[a-z0-9][a-z0-9._/-]*$" },
    "parentGrantId": {
      "type": ["string", "null"],
      "pattern": "^grant:[a-z0-9][a-z0-9._/-]*$",
      "description": "Null only when rooted directly in the owner."
    },
    "grantedBy": {
      "type": "object",
      "required": ["actor", "identityKind"],
      "additionalProperties": false,
      "properties": {
        "actor": { "type": "string" },
        "role": { "type": "string", "pattern": "^role:[a-z0-9][a-z0-9._-]*$" },
        "identityKind": { "enum": ["human", "agent"], "description": "A chain reaching only agent signatures confers nothing (DEFER 8.2)." }
      }
    },
    "grantedTo": {
      "type": "object",
      "required": ["target"],
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string", "pattern": "^(role|actor):[a-z0-9][a-z0-9._-]*$" }
      }
    },
    "envelope": { "$ref": "https://blueprint-spec.dev/schema/v1/authority-envelope.schema.json" },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": {
      "type": ["string", "null"], "format": "date-time",
      "description": "Null permitted only for the owner's own envelopes. MUST NOT exceed the parent grant's interval."
    },
    "redelegation": {
      "type": "object",
      "required": ["permitted"],
      "additionalProperties": false,
      "properties": {
        "permitted": { "type": "boolean" },
        "maxDepth": { "type": "integer", "minimum": 1 },
        "strictSubsetRequired": {
          "const": true,
          "description": "A redelegated envelope MUST be strictly narrower. Equal width would make revocation survivable by re rooting (DEFER 8.3)."
        }
      }
    },
    "revocationAuthority": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^role:[a-z0-9][a-z0-9._-]*$" } },
    "revokedAt": { "type": ["string", "null"], "format": "date-time", "description": "Revocation is transitive down the chain and never invalidates decisions already made (DEFER 8.4)." },
    "revocationCause": { "type": "string" },
    "signature": {
      "type": "object",
      "required": ["algorithm", "keyId", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "ed25519" },
        "keyId": { "type": "string" },
        "value": { "type": "string" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint-spec.dev/schema/v1/utterance.schema.json",
  "title": "SPEAK Utterance",
  "type": "object",
  "required": [
    "contractVersion",
    "utteranceId",
    "idempotencyKey",
    "agreementSha256",
    "speaker",
    "listener",
    "act",
    "scope",
    "classification",
    "records",
    "payloadSha256",
    "provenance",
    "gate",
    "emittedAt",
    "signature",
    "inferenceUse"
  ],
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "speak-utterance/v1"
    },
    "utteranceId": {
      "type": "string",
      "minLength": 8
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^utter:v1:[a-f0-9]{64}$"
    },
    "agreementSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "speaker": {
      "type": "object",
      "required": [
        "brainId",
        "actorId",
        "keyId"
      ],
      "properties": {
        "brainId": {
          "type": "string",
          "pattern": "^brain:[a-z0-9][a-z0-9._-]*$"
        },
        "actorId": {
          "type": "string"
        },
        "keyId": {
          "type": "string"
        }
      }
    },
    "listener": {
      "type": "object",
      "required": [
        "brainId"
      ],
      "properties": {
        "brainId": {
          "type": "string",
          "pattern": "^brain:[a-z0-9][a-z0-9._-]*$"
        }
      }
    },
    "act": {
      "enum": [
        "assert",
        "revise",
        "retract",
        "request",
        "acknowledge"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "originDomain"
      ],
      "properties": {
        "originDomain": {
          "type": "string"
        },
        "targetHint": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "classification": {
      "enum": [
        "brain-portable",
        "public",
        "peer-internal",
        "peer-confidential"
      ]
    },
    "sensitivity": {
      "enum": [
        "none",
        "personal",
        "third-party",
        "confidential"
      ]
    },
    "consent": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "n/a",
            "pending",
            "granted",
            "withdrawn"
          ]
        }
      }
    },
    "authorship": {
      "enum": [
        "human",
        "agent-drafted-human-approved",
        "agent"
      ]
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "recordId",
          "type",
          "title",
          "path",
          "bodySha256",
          "custodyFloor"
        ],
        "properties": {
          "recordId": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "bodySha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "supersedes": {
            "type": [
              "string",
              "null"
            ]
          },
          "originRecordId": {
            "type": [
              "string",
              "null"
            ]
          },
          "custodyFloor": {
            "enum": [
              "C0",
              "C1",
              "C2",
              "C3",
              "C4"
            ],
            "description": "Inherited from the authorizing agreement. The listener must not weaken it."
          }
        }
      }
    },
    "payloadSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRevisionSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "originBrainId"
      ],
      "properties": {
        "originBrainId": {
          "type": "string"
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "redactionManifestSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "gate_export_approval",
        "approvedArtifactSha256",
        "approvedAt",
        "approvedBy"
      ],
      "properties": {
        "gate_export_approval": {
          "enum": [
            "approved"
          ]
        },
        "approvedArtifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "approvedBy": {
          "type": "string"
        }
      }
    },
    "emittedAt": {
      "type": "string",
      "format": "date-time"
    },
    "prevEntrySha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "signature": {
      "type": "object",
      "required": [
        "alg",
        "keyId",
        "sig"
      ],
      "properties": {
        "alg": {
          "enum": [
            "ed25519",
            "eip191"
          ]
        },
        "keyId": {
          "type": "string"
        },
        "sig": {
          "type": "string"
        }
      }
    },
    "inferenceUse": {
      "enum": [
        "prohibited",
        "permitted",
        "permitted-with-notice"
      ],
      "description": "Restated from the agreement so the constraint travels inside the signed envelope."
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint-spec.dev/schema/v1/peer-agreement.schema.json",
  "title": "SPEAK Peer Agreement",
  "type": "object",
  "required": [
    "contractVersion",
    "agreementId",
    "parties",
    "directions",
    "retention",
    "requiredTier",
    "revocation",
    "createdAt",
    "signatures"
  ],
  "additionalProperties": false,
  "$defs": {
    "direction": {
      "type": "object",
      "required": [
        "scopes",
        "classifications",
        "recordTypes",
        "acts",
        "maxCustodyClass",
        "inferenceUse"
      ],
      "properties": {
        "scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "classifications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "brain-portable",
              "public",
              "peer-internal",
              "peer-confidential"
            ]
          }
        },
        "recordTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "acts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "assert",
              "revise",
              "retract",
              "request",
              "acknowledge"
            ]
          }
        },
        "maxSensitivity": {
          "enum": [
            "none",
            "personal",
            "third-party",
            "confidential"
          ]
        },
        "denyKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "onwardTransfer": {
          "enum": [
            "prohibited",
            "permitted-with-notice"
          ]
        },
        "maxCustodyClass": {
          "enum": [
            "C0",
            "C1",
            "C2",
            "C3",
            "C4"
          ],
          "description": "Weakest CONFIDE custody class at which transferred records may be processed. Travels with the record as a floor and may be strengthened but never weakened by the receiver."
        },
        "inferenceUse": {
          "enum": [
            "prohibited",
            "permitted",
            "permitted-with-notice"
          ],
          "description": "Whether transferred records may be sent to any inference provider at all."
        }
      }
    }
  },
  "properties": {
    "contractVersion": {
      "const": "speak-agreement/v1"
    },
    "agreementId": {
      "type": "string"
    },
    "parties": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "brainId",
          "role",
          "keyIds"
        ],
        "properties": {
          "brainId": {
            "type": "string",
            "pattern": "^brain:[a-z0-9][a-z0-9._-]*$"
          },
          "role": {
            "enum": [
              "contributor",
              "organization",
              "peer"
            ]
          },
          "keyIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "directions": {
      "type": "object",
      "required": [
        "outbound",
        "inbound"
      ],
      "properties": {
        "outbound": {
          "$ref": "#/$defs/direction"
        },
        "inbound": {
          "$ref": "#/$defs/direction"
        }
      }
    },
    "retention": {
      "type": "object",
      "required": [
        "onRetract",
        "onRevoke"
      ],
      "properties": {
        "onRetract": {
          "enum": [
            "tombstone-and-quarantine",
            "tombstone-only",
            "purge"
          ]
        },
        "onRevoke": {
          "enum": [
            "retain-with-frozen-provenance",
            "quarantine-all",
            "purge"
          ]
        }
      }
    },
    "requiredTier": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "revocation": {
      "type": "object",
      "required": [
        "effectiveOn"
      ],
      "properties": {
        "effectiveOn": {
          "enum": [
            "signed-notice",
            "immediate"
          ]
        },
        "keyRevocationList": {
          "type": "string"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "signatures": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "brainId",
          "keyId",
          "alg",
          "sig"
        ],
        "properties": {
          "brainId": {
            "type": "string"
          },
          "keyId": {
            "type": "string"
          },
          "alg": {
            "enum": [
              "ed25519",
              "eip191"
            ]
          },
          "sig": {
            "type": "string"
          }
        }
      }
    }
  }
}